# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules

# next.js
/.next/
/out/

# production
/build

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
.DS_Store

# env files
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# playwright
/playwright/.auth
/playwright-report
/test-results

# session tooling logs
.waylog/
.env.local

# prospect research data — real company names, findings and email addresses.
# This repository is public: never commit the seed data. Only the shape is
# documented, in the committed data/prospects.example.json.
/data/prospects.seed.json
/data/prospects*.json
!/data/prospects.example.json
# raw input/output of scripts/prospect-scan.mjs, if run from the repo root
/prospects.json
/findings.json

# Local-only prospecting tooling. Describes outreach methodology, so it stays
# off a public repo, but it must live in the project rather than /tmp because
# the daily routine depends on it.
/scripts/prospecting/
!/scripts/prospecting/candidates.example.json

# Search Console / cloud service-account credentials — NEVER commit (repo is public)
/secrets/
*service-account*.json
*gsc*.json
gcp-*.json
